# =============================================================================
# RentFin — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files with real secrets.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://rentfin:rentfin@localhost:5432/rentfin?schema=public

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ── Payment Provider — Paystack ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Payment Provider — Flutterwave ───────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ── File Storage — AWS S3 ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=rentfin-documents

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rentfin.ng

# ── SMS ──────────────────────────────────────────────────────────────────────
SMS_PROVIDER=termii
SMS_API_KEY=
SMS_SENDER_ID=

# ── Redis (queues, caching) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Encryption (sensitive data at rest) ─────────────────────────────────────
ENCRYPTION_KEY=change-me-32-byte-hex
